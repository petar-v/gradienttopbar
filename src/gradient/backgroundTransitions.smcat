initial,
presentation [label="Presentation ownership"] {
    native [label="Native CSS" color="#2563eb"]:
        No custom layers or timeline
        CSS handles native endpoints,
    "desktop-blend" [label="Desktop blend" color="#0f766e"]:
        Proximity and workspace blends
        Reuse layers as progress changes,
    "overview-blend" [label="Overview blend" color="#7c3aed"]:
        Blend desktop with overview
        Reuse layers and cached opacity;

    native => "desktop-blend": fractional desktop /
        compose layers;
    "desktop-blend" => native: desktop endpoint /
        release layers;

    native => "overview-blend": fractional overview /
        compose layers;
    "desktop-blend" => "overview-blend": overview input /
        capture mixture;
    "overview-blend" => native: native endpoint /
        release layers;
    "overview-blend" => "desktop-blend": fractional desktop /
        restore mixture;
},
final;

initial => native: construct;
presentation => final: destroy /
    restore theme;
